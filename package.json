{
  "name": "@kysion/utils",
  "version": "1.0.8",
  "description": "Kysion Admin实用工具库，提供HTTP请求增强、文件上传下载、多级缓存、增强的本地存储、数据加密解密和常用工具函数",
  "main": "dist/lib/index.js",
  "module": "dist/es/index.js",
  "types": "dist/lib/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "GUIDE.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:lib && npm run build:es",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:es": "tsc -p tsconfig.es.json",
    "build:test": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "typescript",
    "utils",
    "kysion",
    "http-cache",
    "storage",
    "encryption",
    "validation",
    "axios-wrapper",
    "file-upload",
    "file-download"
  ],
  "author": "SupenBysz",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@kysion/types": "workspace:*",
    "axios": "^1.8.4",
    "colord": "^2.9.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "localforage": "^1.10.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=19.1.0",
    "typescript": ">=5.8.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@testing-library/react": "^16.2.0",
    "@types/crypto-js": "latest",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "msw": "^2.7.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "domexception": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react": "^19.0.12"
  }
}
