{
  "name": "@kysion/utils",
  "version": "1.0.8",
  "description": "Kysion Admin实用工具库，提供HTTP请求增强、文件上传下载、多级缓存、增强的本地存储、数据加密解密和常用工具函数",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "es",
    "README.md",
    "GUIDE.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:lib && npm run build:es",
    "build:lib": "tsc -p tsconfig.json",
    "build:es": "tsc -p tsconfig.es.json",
    "build:test": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf lib es",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "typescript",
    "utils",
    "kysion",
    "http-cache",
    "storage",
    "encryption",
    "validation",
    "axios-wrapper",
    "file-upload",
    "file-download"
  ],
  "author": "SupenBysz",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@kysion/types": "file:../types",
    "axios": "^1.8.3",
    "colord": "^2.9.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "localforage": "^1.10.0",
    "nanoid": "^5.1.4"
  },
  "peerDependencies": {
    "react": ">=16.8.0 || >=17.0.0 || >=18.0.0 || >=19.0.0",
    "typescript": ">=4.5.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/react": "^14.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "domexception": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.11"
  }
}
