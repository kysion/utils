{
  "name": "@kysion/utils",
  "version": "1.0.0",
  "description": "Kysion Admin实用工具库，提供HTTP高性能缓存、增强的本地存储、数据加密解密、数据验证等功能。支持版本控制、多级缓存和请求拦截等特性",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "es",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:lib && npm run build:es",
    "build:lib": "tsc -p tsconfig.json",
    "build:es": "tsc -p tsconfig.es.json",
    "build:test": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rimraf lib es",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "typescript",
    "utils",
    "kysion",
    "http-cache",
    "storage",
    "encryption",
    "validation",
    "axios-wrapper"
  ],
  "author": "SupenBysz",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@kysion/types": "file:../types",
    "axios": "^1.8.3",
    "colord": "^2.9.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "klona": "^2.0.6",
    "localforage": "^1.10.0",
    "nanoid": "^5.1.4"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "typescript": ">=5.8.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/axios": "^0.14.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.7.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  }
}
